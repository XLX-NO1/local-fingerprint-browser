{
  "name": "local-fingerprint-browser",
  "version": "1.0.17",
  "private": true,
  "main": "dist-electron/electron-entry.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --mac --dir",
    "smoke:launch": "npm run build:electron && node dist-electron/scripts/launchSmoke.js",
    "smoke:browser": "npm run build && node dist-electron/scripts/browserSmoke.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "local.fingerprint.browser",
    "productName": "Local Fingerprint Browser",
    "files": [
      "dist/**",
      "dist-electron/**",
      "fingerprint-extension/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray-icon-white.png",
        "to": "tray-icon-white.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  }
}
